{
  "name": "ai-powered-flight-booking-automation",
  "version": "1.0.0",
  "description": "AI-assisted Playwright + Cucumber BDD/POM test automation framework for the Multi-City Flight Booking with Ancillary Services use case (MakeMyTrip)",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "cucumber-js",
    "test:tags": "cucumber-js --tags",
    "test:positive": "cucumber-js --tags @positive",
    "test:negative": "cucumber-js --tags @negative",
    "test:search": "cucumber-js --tags @search",
    "pretest": "node src/utils/generateTestData.js",
    "report:generate": "node src/utils/generateReport.js",
    "posttest": "npm run report:generate",
    "install:browsers": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "pom",
    "test-automation",
    "gen-ai"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "multiple-cucumber-html-reporter": "^4.1.0",
    "playwright": "^1.62.0"
  }
}
